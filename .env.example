# Servidor (nunca con prefijo VITE_: no deben llegar al navegador)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Modelo opcional
# GEMINI_MODEL="gemini-3.5-flash"

# JSON completo de la cuenta de servicio de Firebase, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=""
# Solo si tu base de datos de Firestore no es la de firebase-applet-config.json
# FIRESTORE_DATABASE_ID=""

# Alertas a Telegram (opcional)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Mapas (opcional, restringir por dominio)
GOOGLE_MAPS_PLATFORM_KEY=""
